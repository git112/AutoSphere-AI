# ABGA SaaS Platform - Backend Environment Variables

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=abga_saas

# OpenAI Configuration (System Default Key)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Encryption Key (Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com
FROM_NAME=ABGA SaaS
FRONTEND_URL=http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=8000

# n8n outreach (start n8n first — see automation/N8N_SETUP.md)
# Production webhook (workflow must be Active in n8n):
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/outreach-campaign
# Editor test URL only (while "Listen for test event" in n8n):
# N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/outreach-campaign
N8N_WEBHOOK_URL=http://localhost:5678/webhook/outreach-campaign

# Optional: same value in n8n container env OUTREACH_INTERNAL_TOKEN if you secure relay endpoints
# OUTREACH_INTERNAL_TOKEN=
