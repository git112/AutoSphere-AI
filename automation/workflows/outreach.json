    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.BACKEND_URL || 'http://host.docker.internal:8000') + '/api/outreach/campaign-log' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ campaign_name: $json._campaign.campaign_name, contact_name: $json.name, email: $json.email, phone: $json.phone, channel: $json._campaign.channel, status: 'ok', detail: 'processed' }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Outreach-Internal-Token",
              "value": "={{ $env.OUTREACH_INTERNAL_TOKEN || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-log",
      "name": "Log Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2900,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $('Restore Campaign Context').item.json;\nreturn [{ json: item }];"
      },
      "id": "code-continue-batch",
      "name": "Continue Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3060,
        460
      ]
    }
  ],
