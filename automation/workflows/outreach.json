{
  "name": "Outreach Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-campaign",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-outreach",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "webhookId": "outreach-campaign"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'accepted' } }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Support both direct JSON body and nested body formats\nconst raw = $input.first().json;\nconst root = raw.body ?? raw;\n\n// Parse contacts - handle string or array\nlet contacts = root.contacts || [];\nif (typeof contacts === 'string') {\n  try { contacts = JSON.parse(contacts); } catch(e) { contacts = []; }\n}\nif (!Array.isArray(contacts)) contacts = [];\n\nif (contacts.length === 0) {\n  throw new Error('No contacts provided. Send at least one contact in the contacts array.');\n}\n\nconst enableAi = root.enable_ai === true || root.enable_ai === 'true';\n\n// Parse attachments\nlet attachments = root.attachments || [];\nif (typeof attachments === 'string') {\n  try { attachments = JSON.parse(attachments); } catch(e) { attachments = []; }\n}\nif (!Array.isArray(attachments)) attachments = [];\n\nreturn contacts.map((c) => ({\n  json: {\n    name: c.name || '',\n    email: c.email || '',\n    phone: c.phone || '',\n    company: c.company || '',\n    _campaign: {\n      campaign_name: root.campaign_name || 'Campaign',\n      channel: root.channel || 'email',\n      subject: root.subject || 'Hello',\n      message: root.message || '',\n      enable_ai: enableAi,\n      smtp_host: root.smtp_host || '',\n      smtp_port: root.smtp_port || 587,\n      smtp_user: root.smtp_user || '',\n      smtp_pass: root.smtp_pass || '',\n      attachments: attachments\n    }\n  }\n}));"
      },
      "id": "code-expand-contacts",
      "name": "Set Campaign Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        460
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        700,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._campaign.enable_ai }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-ai",
      "name": "IF AI Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        920,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst msg = item._campaign.message || '';\n// Support both {name} and {{name}} style placeholders\nconst final_message = msg\n  .replace(/\\{\\{\\s*name\\s*\\}\\}/gi, item.name || 'there')\n  .replace(/\\{name\\}/gi, item.name || 'there')\n  .replace(/\\{\\{\\s*company\\s*\\}\\}/gi, item.company || 'your company')\n  .replace(/\\{company\\}/gi, item.company || 'your company');\nreturn [{ json: { ...item, final_message } }];"
      },
      "id": "code-template",
      "name": "Template Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst ch = (j._campaign.channel || '').toLowerCase();\nreturn [{\n  json: {\n    ...j,\n    _send_email: (ch === 'email' || ch === 'both') && !!j.email,\n    _send_wa: (ch === 'whatsapp' || ch === 'both') && !!j.phone\n  }\n}];"
      },
      "id": "code-dispatch",
      "name": "Channel Flags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._send_email }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-email",
      "name": "IF Send Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1580,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.BACKEND_URL || 'http://host.docker.internal:8000') + '/api/outreach/relay-smtp' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ smtp_host: $json._campaign.smtp_host, smtp_port: $json._campaign.smtp_port || 587, smtp_user: $json._campaign.smtp_user, smtp_pass: $json._campaign.smtp_pass, to_email: $json.email, subject: $json._campaign.subject, body_text: $json.final_message, attachments: $json._campaign.attachments || [] }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Outreach-Internal-Token",
              "value": "={{ $env.OUTREACH_INTERNAL_TOKEN || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-relay-smtp",
      "name": "Email SMTP Relay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $('Channel Flags').item.json }];"
      },
      "id": "code-after-smtp",
      "name": "Restore After SMTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._send_wa }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-wa",
      "name": "IF Send WhatsApp",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2240,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WHATSAPP_URL || 'http://host.docker.internal:8001') + '/send-whatsapp' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: String($json.phone || '').replace(/\\D/g,''), message: $json.final_message }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-whatsapp",
      "name": "WhatsApp HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2460,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $('Channel Flags').item.json }];"
      },
