{
  "name": "Outreach Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-campaign",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "outreach-campaign-trigger"
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Item Lists: Split Out Contacts",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [460, 300],
      "notesInFlow": true,
      "notes": "Spreads 'contacts' array to items"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $(\"Webhook\").item.json.enable_ai }}",
              "value2": true
            }
          ]
        }
      },
      "name": "IF AI Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_KEY",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{\"parts\":[{\"text\":\"Rewrite this message to be personalized for {{ $json.name }} working at {{ $json.company }}. Original Message: {{ $('Webhook').item.json.message }}\"}]}]"
            }
          ]
        },
        "options": {}
      },
      "name": "Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1120, 160]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Webhook').item.json.channel }}",
              "value2": "email"
            }
          ]
        }
      },
      "name": "Channel Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Webhook').item.json.smtp_user }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $('Webhook').item.json.subject }}",
        "text": "={{ $('IF AI Enabled').item.json.ai_message || $('Webhook').item.json.message }}",
        "options": {}
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1600, 160],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "Dynamic SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/send-whatsapp",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $('IF AI Enabled').item.json.ai_message || $('Webhook').item.json.message }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1600, 400]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "name": "Rate Limit Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "campaign_logs",
        "columns": "campaign_name, contact_name, channel, status",
        "options": {}
      },
      "name": "Postgres Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [2060, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Item Lists: Split Out Contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Item Lists: Split Out Contacts": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches": {
      "main": [
        [
          {
            "node": "IF AI Enabled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF AI Enabled": {
      "main": [
        [
          {
            "node": "Gemini API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Channel Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini API": {
      "main": [
        [
          {
            "node": "Channel Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Decision": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Rate Limit Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Rate Limit Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limit Wait": {
      "main": [
        [
          {
            "node": "Postgres Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Log": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
